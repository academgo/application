  "academgo.malaysia.visa.ru": {
    "afterHeading": "Сроки: сколько ждать eVAL и визу",
    "block": {
      "_type": "timelineBlock",
      "title": "Сколько ждать Student Pass",
      "subtitle": "Сроки от подачи в EMGS до Student Pass",
      "items": [
        {
          "period": "14 рабочих дней",
          "title": "Официальный срок EMGS",
          "text": "Столько EMGS рассматривает полный пакет документов; если чего-то не хватает, заявку рассматривают дольше."
        },
        {
          "period": "4–8 недель",
          "title": "Реальное ожидание eVAL",
          "text": "На практике закладывайте 4–8 недель, в пиковые месяцы — больше; UTM ориентирует студентов на 3–6 недель."
        },
        {
          "period": "Около 48 часов",
          "title": "Виза SEV через eVISA",
          "text": "Сама eVisa после eVAL обрабатывается около 48 часов. Билеты не покупайте до одобрения VAL и SEV."
        },
        {
          "period": "Около 6 месяцев",
          "title": "Срок действия eVAL",
          "text": "eVAL действует ориентировочно 6 месяцев — въехать в Малайзию нужно в этот срок."
        },
        {
          "period": "7 рабочих дней после прилёта",
          "title": "Медосмотр",
          "text": "В панельной клинике EMGS или в клинике вуза; без него EMGS не запустит оформление Student Pass."
        },
        {
          "period": "Не больше 1 года",
          "title": "Student Pass и продление",
          "text": "Student Pass выдаётся обычно не более чем на 1 год, продлевать его нужно до истечения срока."
        }
      ],
      "note": "Считайте время назад от даты начала занятий: оффер, затем 1–2 месяца на EMGS, затем перелёт."
    }
  },
  "academgo.malaysia.visa.en": {
    "afterHeading": "How long EMGS takes",
    "block": {
      "_type": "timelineBlock",
      "title": "How long the Student Pass takes",
      "subtitle": "Timings from the EMGS application to the Student Pass",
      "items": [
        {
          "period": "14 working days",
          "title": "Official EMGS target",
          "text": "The official processing time, but only for a complete application; missing or unclear documents add time."
        },
        {
          "period": "4–8 weeks",
          "title": "Realistic wait for the eVAL",
          "text": "Plan 4–8 weeks from a complete submission, longer in peak months; UTM budgets 3–6 weeks for the approval letter."
        },
        {
          "period": "About 48 hours",
          "title": "Single Entry Visa on eVISA",
          "text": "If your country needs a visa, the SEV on the official eVISA portal takes about 48 hours."
        },
        {
          "period": "Around 6 months",
          "title": "eVAL validity",
          "text": "The eVAL is usually valid for around 6 months, and you must enter Malaysia within that time."
        },
        {
          "period": "Within 7 working days of arrival",
          "title": "Medical screening",
          "text": "At an EMGS panel clinic or a registered university clinic; without the result, EMGS will not start the endorsement."
        },
        {
          "period": "Up to 1 year",
          "title": "Student Pass and renewal",
          "text": "The pass is usually issued for no more than 1 year and must be renewed before it expires."
        }
      ],
      "note": "Do not buy flights until both the approval letter and the SEV are issued."
    }
  },
